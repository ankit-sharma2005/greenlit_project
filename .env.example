# Copy to .env and adjust if needed. Never commit .env.
# Compose works with the defaults below even without a .env file.

# --- Host ports (the ports inside the containers never change) ---
WEB_PORT=5177
API_PORT=8003
POSTGRES_PORT=5436
REDIS_PORT=6382

# --- Database / cache ---
POSTGRES_USER=greenlit
# Change this before any real deployment; the default is public in the repo.
POSTGRES_PASSWORD=greenlit
POSTGRES_DB=greenlit
DATABASE_URL=postgresql+psycopg://greenlit:greenlit@postgres:5432/greenlit
REDIS_URL=redis://redis:6379/0

# --- App ---
# Used to encrypt provider/connector API keys at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Change this before any real deployment; the default is public in the repo.
APP_SECRET_KEY=change-me-in-production-use-at-least-32-characters
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins for CORS.
WEB_ORIGIN=http://localhost:5177
# API base URL the browser uses (host-side API port above).
VITE_API_BASE_URL=http://localhost:8003

# --- Defaults (mirrored in Settings -> Advanced) ---
DEFAULT_TIMEOUT_SECONDS=60
DEFAULT_RUN_PARALLELISM=2

# --- Accounts and sessions ---
# Extra FastAPI debug output. Keep false anywhere but your own machine.
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30
# Failed sign-ins allowed per window before the account is throttled.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# Leave unset to decide per request (Secure only over HTTPS); set true behind TLS.
# COOKIE_SECURE=true

# --- Provider calls ---
# Timeout, retries and backoff multiplier for every model/connector request.
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_FACTOR=2.0

# --- Built-in demo (docker compose --profile demo) ---
# URLs the API calls from inside Compose; the host ports are only for your browser.
DEMO_APP_URL=http://demo-app:9000/chat
DEMO_APP_BROKEN_URL=http://demo-app-broken:9000/chat
DEMO_APP_PORT=9301
DEMO_APP_BROKEN_PORT=9302

# --- End-to-end script (scripts/run-e2e.sh), optional ---
# Override the disposable stack if these ports are taken; it never reuses the ports above.
# E2E_API_PORT=8103
# E2E_WEB_PORT=5277
# E2E_POSTGRES_PORT=5536
# E2E_REDIS_PORT=6482
# E2E_DEMO_GOOD_PORT=9501
# E2E_DEMO_BROKEN_PORT=9502
