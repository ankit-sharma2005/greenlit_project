# Copy to .env and adjust if needed. Never commit .env.
# Compose works with the defaults below even without a .env file.

# --- Host ports (the ports inside the containers never change) ---
WEB_PORT=5177
API_PORT=8003
POSTGRES_PORT=5436
REDIS_PORT=6382

# --- Database / cache ---
POSTGRES_USER=greenlit
POSTGRES_PASSWORD=greenlit
POSTGRES_DB=greenlit
DATABASE_URL=postgresql+psycopg://greenlit:greenlit@postgres:5432/greenlit
REDIS_URL=redis://redis:6379/0

# --- App ---
# Used to encrypt provider/connector API keys at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-in-production
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins for CORS.
WEB_ORIGIN=http://localhost:5177
# API base URL the browser uses (host-side API port above).
VITE_API_BASE_URL=http://localhost:8003

# --- Defaults (mirrored in Settings -> Advanced) ---
DEFAULT_TIMEOUT_SECONDS=60
DEFAULT_RUN_PARALLELISM=2
